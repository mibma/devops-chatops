pipeline {
    agent any

    parameters {
        string(name: 'VERSION',      defaultValue: 'latest',
               description: 'Git tag or branch to deploy (e.g. v1.2, main, latest)')
        string(name: 'TRIGGERED_BY', defaultValue: '',
               description: 'Slack user ID who triggered this build')
    }

    environment {
        REPO_URL = 'https://github.com/kisa-fatima/demo-devops-project.git'
        EC3_USER = 'ubuntu'
        EC3_HOST = '3.25.234.220'
        EC3_APP  = '/home/ubuntu/demo-devops-project'
    }

    stages {

        stage('Checkout') {
            steps {
                git url: "${env.REPO_URL}", branch: 'main'
            }
        }

        stage('Setup Linters') {
            steps {
                writeFile file: 'package.json', text: '''{
  "name": "demo-devops-project",
  "private": true,
  "devDependencies": {
    "html-validate": "^9.3.0",
    "eslint": "^8.57.0",
    "stylelint": "^16.3.0",
    "stylelint-config-standard": "^36.0.0"
  }
}'''
                writeFile file: '.eslintrc.json', text: '''{
  "env": { "browser": true, "es2021": true },
  "extends": ["eslint:recommended"],
  "parserOptions": { "ecmaVersion": 2021 },
  "rules": { "no-unused-vars": "warn", "no-console": "off" }
}'''
                writeFile file: '.htmlvalidate.json', text: '''{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-trailing-whitespace": "off",
    "attr-quotes": "off",
    "void-style": "off"
  }
}'''
                writeFile file: '.stylelintrc.json', text: '''{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "no-descending-specificity": null,
    "color-function-notation": null,
    "alpha-value-notation": null
  }
}'''
                sh 'npm install'
            }
        }

        stage('HTML Validate') {
            steps {
                sh 'npx html-validate index.html'
            }
        }

        stage('JS Lint') {
            steps {
                sh 'npx eslint script.js'
            }
        }

        stage('CSS Lint') {
            steps {
                sh 'npx stylelint styles.css'
            }
        }

        stage('Deploy to EC2') {
            steps {
                sshagent(credentials: ['ec3-deploy-key']) {
                    script {
                        def ver = params.VERSION ?: 'latest'
                        def gitCmd = (ver == 'latest' || ver == 'main')
                            ? "git -C ${env.EC3_APP} pull origin main"
                            : "git -C ${env.EC3_APP} checkout -f ${ver}"
                        sh """
                            ssh -o StrictHostKeyChecking=no ${env.EC3_USER}@${env.EC3_HOST} \
                                'git -C ${env.EC3_APP} fetch --all --tags && ${gitCmd} && sudo systemctl reload nginx'
                        """
                    }
                }
            }
        }

        stage('Smoke Test') {
            steps {
                sh """
                    STATUS=\$(curl -s -o /dev/null -w '%{http_code}' http://${env.EC3_HOST}/)
                    [ "\$STATUS" = "200" ] || { echo "Smoke test FAILED — HTTP \$STATUS"; exit 1; }
                    echo "Smoke test PASSED — HTTP \$STATUS"
                """
            }
        }
    }

    post {
        success { script { _notifySlack(':white_check_mark:', 'PASSED') } }
        failure  { script { _notifySlack(':x:', 'FAILED') } }
    }
}

def _notifySlack(String icon, String status) {
    def msg = "${icon} *${env.JOB_NAME}* #${env.BUILD_NUMBER} — ${status}\n" +
              "Version: \`${params.VERSION ?: 'latest'}\`  |  <${env.BUILD_URL}|View build>"
    withCredentials([string(credentialsId: 'slack-bot-token', variable: 'STOKEN')]) {
        writeFile file: 'notify_slack.py', text: """
import json, urllib.request, os
payload = json.dumps({"channel": "#deployments", "text": os.environ["SLACK_MSG"]}).encode()
urllib.request.urlopen(urllib.request.Request(
    "https://slack.com/api/chat.postMessage",
    data=payload,
    headers={
        "Authorization": "Bearer " + os.environ["STOKEN"],
        "Content-Type": "application/json"
    }
))
print("Slack notified")
"""
        withEnv(["SLACK_MSG=${msg}"]) {
            sh 'python3 notify_slack.py'
        }
    }
}
