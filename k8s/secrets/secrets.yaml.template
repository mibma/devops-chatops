# Copy to secrets.yaml and fill in values (do NOT commit).
# For production, use external secret managers (Vault, AWS SM via CSI driver).
apiVersion: v1
kind: Secret
metadata:
  name: chatops-secrets
  namespace: devops-tools
type: Opaque
stringData:
  database-url: "postgresql://chatops:CHANGE_ME@postgres:5432/chatops"
  redis-url: "redis://redis:6379/0"
  jenkins-url: "http://jenkins.internal"
  jenkins-user: "chatops-bot"
  jenkins-token: "CHANGE_ME"
  slack-bot-token: "xoxb-CHANGE_ME"
  slack-signing-secret: "CHANGE_ME"
  slack-app-token: "xapp-CHANGE_ME"
