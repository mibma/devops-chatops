EC2_TARGET_NAME=hello-cicd
EC2_HTTP_URL=http://your-ec2-public-dns/
EC2_INSTANCE_ID=i-0123456789abcdef0
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EC2_SSH_HOST=your-ec2-public-dns
EC2_SSH_USER=ubuntu
EC2_SSH_KEY_PATH=/app/keys/ec2.pem
