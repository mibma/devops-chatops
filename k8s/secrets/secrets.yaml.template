# Copy to secrets.yaml, fill in every CHANGE_ME value, then:
#   kubectl apply -f k8s/secrets/secrets.yaml
# NEVER commit secrets.yaml — it is in .gitignore.
apiVersion: v1
kind: Secret
metadata:
  name: chatops-secrets
  namespace: devops-tools
type: Opaque
stringData:
  # --- Postgres ---
  postgres-password: "CHANGE_ME"
  database-url: "postgresql://chatops:CHANGE_ME@postgres:5432/chatops"

  # --- Redis ---
  redis-url: "redis://redis:6379/0"

  # --- Slack ---
  slack-bot-token: "xoxb-CHANGE_ME"
  slack-signing-secret: "CHANGE_ME"
  slack-app-token: "xapp-CHANGE_ME"

  # --- Jenkins ---
  jenkins-url: "http://jenkins.internal"
  jenkins-user: "chatops-bot"
  jenkins-token: "CHANGE_ME"

  # --- EC2 / hello-cicd ---
  ec2-target-name: "hello-cicd"
  ec2-http-url: "http://CHANGE_ME/"
  ec2-instance-id: "i-CHANGE_ME"
  aws-region: "ap-southeast-2"
  aws-access-key-id: "CHANGE_ME"
  aws-secret-access-key: "CHANGE_ME"
  ec2-ssh-host: "CHANGE_ME"
  ec2-ssh-user: "ubuntu"
  ec2-service-name: "nginx"
